# Compose project names must be unique per researcher and local instance.
# Keep this lowercase pattern and replace both identity segments before use.
COMPOSE_PROJECT_NAME=libramas-g1-researcher01-local01

RECPRO_APP_ENV=development
RECPRO_LOG_LEVEL=INFO
# Formal HS256 Bearer authentication is opt-in and remains disabled for the
# default local skeleton.  Never commit the populated secret.
RECPRO_AUTH_ENABLED=false
RECPRO_AUTH_JWT_SECRET=
RECPRO_AUTH_JWT_ISSUER=libramas-local
RECPRO_AUTH_JWT_AUDIENCE=libramas-api
RECPRO_AUTH_CLOCK_SKEW_SECONDS=30
RECPRO_DEBUG_API_ENABLED=false
RECPRO_CONFIG_BUNDLE_VERSION=rec-1.0.0
RECPRO_CONFIG_BUNDLE_PATH=contracts/config/examples/rec-1.0.0.json
RECPRO_CONFIG_BUNDLE_SHA256=220b0fb30f38fef7ca148c43b1f2751715c7df7ecf7d47e7ddfce7ff2847a5c6

# Application identity. The password must be supplied only in the ignored
# .env.compose file; an empty value makes Compose fail before startup.
RECPRO_MYSQL_HOST=mysql
RECPRO_MYSQL_PORT=3306
RECPRO_MYSQL_DATABASE=recpro
RECPRO_MYSQL_USER=recpro_runtime
RECPRO_MYSQL_PASSWORD=
RECPRO_MYSQL_MIGRATION_USER=recpro_migrator
RECPRO_MYSQL_MIGRATION_PASSWORD=
RECPRO_MYSQL_CONNECT_TIMEOUT_SECONDS=3
RECPRO_PERSISTENCE_PROBE_ID=libramas-g1-researcher01-local01

# Bootstrap-only MySQL credential; it is not passed to backend or worker.
RECPRO_MYSQL_ROOT_PASSWORD=
RECPRO_MYSQL_HOST_PORT=3306

# Neo4j remains optional to the backend recommendation path in G1.
RECPRO_NEO4J_USER=neo4j
RECPRO_NEO4J_PASSWORD=
RECPRO_NEO4J_HTTP_HOST_PORT=7474
RECPRO_NEO4J_BOLT_HOST_PORT=7687

RECPRO_BACKEND_HOST_PORT=8000
RECPRO_FRONTEND_HOST_PORT=5173
