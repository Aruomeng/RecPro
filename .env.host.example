# Host-mode backend configuration. Copy to an ignored .env.host file and set
# the password locally; do not commit the populated file.
RECPRO_APP_ENV=development
# The separate MySQL-backed demo entrypoint is fail-closed unless this is
# explicitly changed to true for a reviewed local run. The default backend
# remains health-only.
RECPRO_DEMO_HTTP_ENABLED=false
RECPRO_LOG_LEVEL=INFO
# Formal HS256 Bearer authentication is opt-in and remains disabled for the
# default local skeleton.  Never commit the populated secret.
RECPRO_AUTH_ENABLED=false
RECPRO_AUTH_JWT_SECRET=
RECPRO_AUTH_JWT_ISSUER=libramas-local
RECPRO_AUTH_JWT_AUDIENCE=libramas-api
RECPRO_AUTH_CLOCK_SKEW_SECONDS=30
RECPRO_PRODUCTION_HTTP_ENABLED=false
# G4 HTTP requires a reviewed, explicit research composition; keep closed by default.
RECPRO_G4_HTTP_ENABLED=false
# Requires demo + G4 HTTP + DeepSeek; enables only IntentUnderstandingAgent.
RECPRO_G4_LLM_INTENT_ENABLED=false
# G5 interaction HTTP is a separate write-capable research composition; keep
# closed until a concrete ChangePlan is approved.
RECPRO_G5_INTERACTION_HTTP_ENABLED=false
RECPRO_DEBUG_API_ENABLED=false
RECPRO_CONFIG_BUNDLE_VERSION=rec-1.0.0
RECPRO_CONFIG_BUNDLE_PATH=contracts/config/examples/rec-1.0.0.json
RECPRO_CONFIG_BUNDLE_SHA256=220b0fb30f38fef7ca148c43b1f2751715c7df7ecf7d47e7ddfce7ff2847a5c6
RECPRO_LLM_PROVIDER=mock
RECPRO_LLM_BASE_URL=https://api.deepseek.com
RECPRO_LLM_MODEL=deepseek-v4-flash
RECPRO_LLM_API_KEY=
RECPRO_LLM_TIMEOUT_SECONDS=20
RECPRO_LLM_MAX_OUTPUT_TOKENS=512
RECPRO_PROMPT_BUNDLE_VERSION=prompt-v1
RECPRO_PROMPT_BUNDLE_PATH=contracts/prompts/rec-prompts-v1.0.0.json
RECPRO_PROMPT_BUNDLE_SHA256=bad547702e4c3b42395280ea44781e60992a85f981605afbcd29aa13d33db94a

RECPRO_MYSQL_HOST=127.0.0.1
RECPRO_MYSQL_PORT=3306
RECPRO_MYSQL_DATABASE=recpro
RECPRO_MYSQL_USER=recpro_runtime
RECPRO_MYSQL_PASSWORD=
RECPRO_MYSQL_MIGRATION_USER=recpro_migrator
RECPRO_MYSQL_MIGRATION_PASSWORD=
RECPRO_MYSQL_CONNECT_TIMEOUT_SECONDS=3
# Must equal the COMPOSE_PROJECT_NAME of the isolated infrastructure instance.
RECPRO_PERSISTENCE_PROBE_ID=libramas-g1-researcher01-local01
# Worker deployment is fail-closed and disabled in host-mode examples.
RECPRO_WORKER_ENABLED=false
RECPRO_WORKER_MODE=disabled
RECPRO_WORKER_ID=recpro-worker
RECPRO_WORKER_POLL_INTERVAL_SECONDS=5
RECPRO_WORKER_BATCH_LIMIT=10
RECPRO_WORKER_LEASE_SECONDS=60
RECPRO_WORKER_MAX_ATTEMPTS=3
RECPRO_WORKER_FORMULA_VERSION=profile-g2-v1
RECPRO_BACKEND_PORT=8000
