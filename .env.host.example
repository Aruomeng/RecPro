# Host-mode backend configuration. Copy to an ignored .env.host file and set
# the password locally; do not commit the populated file.
RECPRO_APP_ENV=development
RECPRO_LOG_LEVEL=INFO
RECPRO_CONFIG_BUNDLE_VERSION=rec-1.0.0
RECPRO_CONFIG_BUNDLE_PATH=contracts/config/examples/rec-1.0.0.json
RECPRO_CONFIG_BUNDLE_SHA256=220b0fb30f38fef7ca148c43b1f2751715c7df7ecf7d47e7ddfce7ff2847a5c6

RECPRO_MYSQL_HOST=127.0.0.1
RECPRO_MYSQL_PORT=3306
RECPRO_MYSQL_DATABASE=recpro
RECPRO_MYSQL_USER=recpro_runtime
RECPRO_MYSQL_PASSWORD=
RECPRO_MYSQL_CONNECT_TIMEOUT_SECONDS=3
# Must equal the COMPOSE_PROJECT_NAME of the isolated infrastructure instance.
RECPRO_PERSISTENCE_PROBE_ID=libramas-g1-researcher01-local01
RECPRO_BACKEND_PORT=8000
