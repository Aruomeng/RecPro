# Production overlay values.  Copy to an ignored .env.production file and
# inject real values through a protected environment or secret manager.
# This example is documentation only; it never starts containers.
COMPOSE_PROJECT_NAME=libramas-production-researcher01
RECPRO_APP_ENV=production
RECPRO_PRODUCTION_HTTP_ENABLED=true
RECPRO_AUTH_ENABLED=true
RECPRO_AUTH_MODE=oidc
RECPRO_AUTH_COOKIE_SECURE=true
RECPRO_OIDC_ISSUER=https://id.example.edu
RECPRO_OIDC_AUDIENCE=libramas-api
RECPRO_OIDC_JWKS_URI=https://id.example.edu/.well-known/jwks.json
RECPRO_OIDC_JWKS_CACHE_SECONDS=900

# Runtime data identities must be distinct from root/neo4j administrators.
RECPRO_MYSQL_USER=recpro_runtime
RECPRO_MYSQL_PASSWORD=
RECPRO_NEO4J_READ_USER=recpro_graph_reader
RECPRO_NEO4J_READ_PASSWORD=

# TLS files are supplied by the host secret manager and mounted read-only.
RECPRO_TLS_CERT_FILE=/secure/path/libramas/fullchain.pem
RECPRO_TLS_KEY_FILE=/secure/path/libramas/privkey.pem
RECPRO_HTTPS_HOST_PORT=8443

# The base compose file still requires the normal bundle and bootstrap values.
RECPRO_MYSQL_DATABASE=recpro
RECPRO_MYSQL_ROOT_PASSWORD=
RECPRO_MYSQL_MIGRATION_USER=recpro_migrator
RECPRO_MYSQL_MIGRATION_PASSWORD=
RECPRO_CONFIG_BUNDLE_SHA256=220b0fb30f38fef7ca148c43b1f2751715c7df7ecf7d47e7ddfce7ff2847a5c6
RECPRO_PROMPT_BUNDLE_SHA256=1fa3b19788574189ae1680a0ef5565fd378200d146d9c0ba83da583ba3abce1a
