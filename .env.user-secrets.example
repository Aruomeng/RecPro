# Copy to .env.user-secrets locally; never commit the copied file.
RECPRO_MYSQL_ADMIN_USER=root
RECPRO_MYSQL_ADMIN_PASSWORD=
RECPRO_NEO4J_ADMIN_USER=neo4j
RECPRO_NEO4J_ADMIN_PASSWORD=
RECPRO_LIBRARY_NEO4J_PROJECT_NAME=recpro-library-neo4j-<unique-id>
RECPRO_LIBRARY_NEO4J_HTTP_HOST_PORT=62475
RECPRO_LIBRARY_NEO4J_BOLT_HOST_PORT=62688

# Optional external LLM.  Keep the safe default and leave the key blank until
# the provider is explicitly reviewed; never commit the populated value.
RECPRO_LLM_PROVIDER=mock
RECPRO_LLM_BASE_URL=https://api.deepseek.com
RECPRO_LLM_MODEL=deepseek-chat
RECPRO_LLM_API_KEY=
RECPRO_LLM_TIMEOUT_SECONDS=20
RECPRO_LLM_MAX_OUTPUT_TOKENS=512
