# Preserve Finder metadata locally while keeping it outside project commits.
.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.runtime/
.venv/
.venv-*/
node_modules/
dist/
artifacts/
# Experiment runs are immutable local artifacts.  Configurations remain tracked,
# while predictions/reports never enter source-control or overwrite prior runs.
experiments/runs/
# User-provided scraped books and local license evidence are inspected by the
# intake gate but are never committed as source or experiment artifacts.
data/incoming/books/
# Local Chroma persistent stores are runtime data and are never committed.
data/chroma*/
# User-provided scraped library data stays local; only normalized contracts and
# hashes are versioned.
Lib/
.env
.env.*
!.env.user-secrets.example
!.env.example
!.env.host.example
!.env.compose.example
