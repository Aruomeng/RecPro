{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recpro.local/contracts/agent/policy-result.schema.json",
  "title": "PolicyResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "retrieval_plan", "clarification_questions"],
  "properties": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_type",
        "delivery_strategy",
        "explanation_level",
        "adaptation_state",
        "decision_reason_codes",
        "decision_reason",
        "policy_version"
      ],
      "properties": {
        "output_type": {
          "type": "string",
          "enum": ["PERSONALIZED_FEED", "TOPIC_RESOURCES", "BOOKLIST", "READING_PATH"]
        },
        "delivery_strategy": {"type": "string", "enum": ["DIRECT", "GUIDED", "DEGRADED"]},
        "explanation_level": {"type": "string", "enum": ["SUMMARY", "EVIDENCE", "LIMITED"]},
        "adaptation_state": {"type": "string", "enum": ["NORMAL", "FEEDBACK_ADJUSTED"]},
        "decision_reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "decision_reason": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1}
      }
    },
    "retrieval_plan": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan_version", "min_candidates", "resource_quotas", "channels"],
          "properties": {
            "plan_version": {"type": "integer", "minimum": 1},
            "min_candidates": {"type": "integer", "minimum": 1},
            "resource_quotas": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "BOOK": {"type": "integer", "minimum": 0},
                "PAPER": {"type": "integer", "minimum": 0}
              }
            },
            "channels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "top_k", "timeout_ms", "required", "weight"],
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": ["PROFILE", "KEYWORD", "VECTOR", "GRAPH", "TRENDING", "FEEDBACK"]
                  },
                  "top_k": {"type": "integer", "minimum": 1},
                  "timeout_ms": {"type": "integer", "minimum": 1},
                  "required": {"type": "boolean"},
                  "weight": {"type": "number", "minimum": 0, "maximum": 1}
                }
              }
            }
          }
        }
      ]
    },
    "clarification_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "question", "options", "required"],
        "properties": {
          "slot": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "required": {"type": "boolean"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {"delivery_strategy": {"const": "GUIDED"}},
            "required": ["delivery_strategy"]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "retrieval_plan": {"type": "null"},
          "clarification_questions": {"minItems": 1}
        }
      },
      "else": {
        "properties": {
          "retrieval_plan": {"type": "object"}
        }
      }
    }
  ]
}
