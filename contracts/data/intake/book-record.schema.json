{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recpro.local/contracts/data/intake/book-record.schema.json",
  "title": "LibraMAS normalized library book record",
  "description": "Canonical, user-independent book metadata accepted after source-specific normalization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "source_record_id",
    "title",
    "authors",
    "retrieved_at",
    "availability_status"
  ],
  "properties": {
    "schema_version": {"const": "library-book-record-v1"},
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "isbn": {
      "type": "string",
      "pattern": "^[0-9Xx-]{10,17}$"
    },
    "abstract": {
      "type": "string",
      "maxLength": 20000
    },
    "keywords": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "publisher": {
      "type": "string",
      "maxLength": 500
    },
    "publication_year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 2200
    },
    "publication_date": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z]{2,4})?$"
    },
    "category_code": {
      "type": "string",
      "maxLength": 64
    },
    "call_number": {
      "type": "string",
      "maxLength": 128
    },
    "location": {
      "type": "string",
      "maxLength": 255
    },
    "borrowable_copies": {
      "type": "integer",
      "minimum": 0
    },
    "access_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1000
    },
    "availability_status": {
      "type": "string",
      "enum": [
        "AVAILABLE_BORROW",
        "AVAILABLE_ONLINE",
        "REFERENCE_ONLY",
        "TEMPORARILY_UNAVAILABLE"
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "normalized_name", "weight", "confidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "normalized_name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
          },
          "weight": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1000
    },
    "license_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{1,127}$"
    },
    "license_evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
