{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recpro.local/contracts/safety/change-plan.schema.json",
  "title": "LibraMAS ChangePlan",
  "description": "Fail-closed plan for read-only, append-only, or controlled status-change work. Destructive work is outside this schema and requires a separately approved deletion request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "created_at",
    "git_commit",
    "classification",
    "mode",
    "intent",
    "environment",
    "targets",
    "input_hashes",
    "idempotency_key",
    "max_changes",
    "preconditions",
    "safety_assertions",
    "plan_hash"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "plan_id": {"type": "string", "format": "uuid"},
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:[zZ]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "classification": {"type": "string", "enum": ["S0_READ_ONLY", "S1_APPEND", "S2_CONTROLLED_UPDATE"]},
    "mode": {"type": "string", "enum": ["DRY_RUN", "APPLY"]},
    "intent": {"type": "string", "minLength": 1, "maxLength": 2000},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "workspace", "host_fingerprint"],
      "properties": {
        "environment_id": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "pattern": "^/"},
        "host_fingerprint": {"type": "string", "minLength": 1},
        "database_identity": {"type": ["string", "null"]},
        "index_namespace": {"type": ["string", "null"]}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "identifier", "operation", "expected_before_count", "expected_after_min_count"],
        "properties": {
          "kind": {"type": "string", "enum": ["FILE", "MYSQL", "CHROMA", "NEO4J", "DOCKER", "GIT"]},
          "identifier": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "enum": ["READ", "CREATE", "APPEND", "UPDATE_STATUS", "START", "STOP", "COMMIT"]},
          "expected_before_count": {"type": "integer", "minimum": 0},
          "expected_after_min_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "input_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 128},
    "request_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "request_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "session_id",
        "user_id",
        "scene",
        "input_text",
        "requested_resource_types",
        "requested_output_type",
        "limit",
        "g4_channels"
      ],
      "properties": {
        "request_id": {"type": "string", "format": "uuid"},
        "session_id": {"type": "string", "format": "uuid"},
        "user_id": {"type": "integer", "minimum": 1},
        "scene": {"type": "string", "const": "SEARCH_AFTER"},
        "input_text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "requested_resource_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"type": "string", "enum": ["BOOK", "PAPER"]},
          "uniqueItems": true
        },
        "requested_output_type": {
          "type": "string",
          "enum": ["TOPIC_RESOURCES", "READING_PATH"]
        },
        "limit": {"type": "integer", "minimum": 1, "maximum": 20},
        "g4_channels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "string", "enum": ["MYSQL", "GRAPH", "VECTOR"]},
          "uniqueItems": true
        }
      }
    },
    "interaction_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "recommendation_task_id",
        "recommendation_record_id",
        "recommendation_item_id",
        "resource_id",
        "resource_type",
        "impression_uuid",
        "feedback_uuid",
        "behavior_uuid",
        "behavior_session_id",
        "feedback_type",
        "reason_code",
        "impression_rendered_at",
        "impression_visible_started_at",
        "feedback_occurred_at",
        "behavior_occurred_at",
        "direct_behavior_type",
        "query_text",
        "position",
        "impression_visible_ms",
        "impression_max_visible_ratio",
        "direct_behavior_dwell_ms",
        "direct_behavior_visible_ratio",
        "worker_id",
        "worker_limit",
        "formula_version"
      ],
      "properties": {
        "user_id": {"type": "integer", "minimum": 1},
        "recommendation_task_id": {"type": "string", "format": "uuid"},
        "recommendation_record_id": {"type": "integer", "minimum": 1},
        "recommendation_item_id": {"type": "integer", "minimum": 1},
        "resource_id": {"type": "integer", "minimum": 1},
        "resource_type": {"type": "string", "const": "BOOK"},
        "impression_uuid": {"type": "string", "format": "uuid"},
        "feedback_uuid": {"type": "string", "format": "uuid"},
        "behavior_uuid": {"type": "string", "format": "uuid"},
        "behavior_session_id": {"type": "string", "format": "uuid"},
        "feedback_type": {"type": "string", "const": "NOT_INTERESTED"},
        "reason_code": {"type": "string", "const": "TOPIC_NOT_INTERESTED"},
        "impression_rendered_at": {"type": "string", "format": "date-time"},
        "impression_visible_started_at": {"type": "string", "format": "date-time"},
        "feedback_occurred_at": {"type": "string", "format": "date-time"},
        "behavior_occurred_at": {"type": "string", "format": "date-time"},
        "direct_behavior_type": {"type": "string", "const": "CLICK_RECOMMENDATION"},
        "query_text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "position": {"type": "integer", "minimum": 1},
        "impression_visible_ms": {"type": "integer", "minimum": 1000},
        "impression_max_visible_ratio": {"type": "number", "minimum": 0.5, "maximum": 1},
        "direct_behavior_dwell_ms": {"type": "integer", "minimum": 0},
        "direct_behavior_visible_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "worker_id": {"type": "string", "minLength": 3, "maxLength": 64},
        "worker_limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "formula_version": {"type": "string", "const": "profile-g2-v1"}
      }
    },
    "max_changes": {"type": "integer", "minimum": 0},
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "safety_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_deletions",
        "database_physical_deletions",
        "overwrite_existing",
        "destructive_capabilities_required",
        "counts_must_not_decrease"
      ],
      "properties": {
        "file_deletions": {"const": 0},
        "database_physical_deletions": {"const": 0},
        "overwrite_existing": {"const": false},
        "destructive_capabilities_required": {"const": false},
        "counts_must_not_decrease": {"const": true}
      }
    },
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
