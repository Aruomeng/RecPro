{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recpro.local/contracts/verification/g4-projection-recovery-evidence.schema.json",
  "title": "G4 recommendation projection recovery evidence",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "recovery_reason",
    "run_id",
    "approved_plan_id",
    "approved_plan_hash",
    "plan_path",
    "plan_git_commit",
    "current_git_commit",
    "request_id",
    "session_id",
    "user_id",
    "database_guard",
    "before_counts",
    "after_counts",
    "deltas",
    "response_summary",
    "replay_summary",
    "task_facts",
    "intent_agent",
    "chroma_count_before",
    "chroma_count_after",
    "database_reads",
    "database_write_rows",
    "database_writes",
    "external_requests",
    "external_llm_requests",
    "graph_writes",
    "neo4j_writes",
    "chroma_writes",
    "outbox_claims",
    "actual_delete_count",
    "files_deleted",
    "overwritten_inputs",
    "plan_raw_sha256"
  ],
  "properties": {
    "schema_version": {"const": "g4-recommendation-projection-recovery-v1"},
    "status": {"const": "PASS"},
    "recovery_reason": {"const": "executor_artifact_directory_collision_after_commit"},
    "run_id": {"type": "string", "minLength": 3, "maxLength": 64},
    "approved_plan_id": {"type": "string", "format": "uuid"},
    "approved_plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_path": {"type": "string", "minLength": 1},
    "plan_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "current_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "request_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "user_id": {"type": "integer", "minimum": 1},
    "database_guard": {"type": "object", "required": ["probe_id", "database", "current_user", "grants_safe"], "properties": {"probe_id": {"type": "string"}, "database": {"type": "string"}, "current_user": {"type": "string"}, "grants_safe": {"const": true}}},
    "before_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "after_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "deltas": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "response_summary": {"type": "object"},
    "replay_summary": {"type": "object", "required": ["status_code", "idempotency_replayed", "same_task_identity", "zero_additional_row_delta"], "properties": {"status_code": {"const": 200}, "idempotency_replayed": {"const": "true"}, "same_task_identity": {"const": true}, "zero_additional_row_delta": {"const": true}}},
    "task_facts": {"type": "object"},
    "intent_agent": {"type": "object", "required": ["agent_version", "fallback_used", "llm_provider", "llm_attempts"], "properties": {"agent_version": {"const": "intent-llm-prompt-v1"}, "fallback_used": {"const": false}, "llm_provider": {"const": "deepseek"}, "llm_attempts": {"type": "integer", "minimum": 1, "maximum": 2}}},
    "chroma_count_before": {"type": "integer", "minimum": 1},
    "chroma_count_after": {"type": "integer", "minimum": 1},
    "database_reads": {"type": "integer", "minimum": 1},
    "database_write_rows": {"type": "integer", "minimum": 1},
    "database_writes": {"type": "integer", "minimum": 1},
    "external_requests": {"type": "integer", "minimum": 1, "maximum": 2},
    "external_llm_requests": {"type": "integer", "minimum": 1, "maximum": 2},
    "graph_writes": {"const": 0},
    "neo4j_writes": {"const": 0},
    "chroma_writes": {"const": 0},
    "outbox_claims": {"const": 0},
    "actual_delete_count": {"const": 0},
    "files_deleted": {"const": 0},
    "overwritten_inputs": {"const": 0},
    "plan_raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
